rules_version = '2';

// An account's progress lives under userProgress/{uid}:
//   • the document itself: DSA progress and planning (and, for older
//     accounts, the old copies of everything else, which the app now only
//     reads);
//   • notes/{key}~{id}: one document per note, versioned like git;
//   • data/{key}: one document per other kind of progress (ticks, the job
//     tracker…);
//   • noteAssets/, history/: screenshots and note version history.
// A Firestore document holds at most 1 MB, which is why notes are split out.
//
// Deploying this file REPLACES the rules currently configured in the Firebase
// console — check they match before running `firebase deploy --only firestore`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The note fields: versioned, fast-forward only. Keep in step with
    // VERSIONED in src/Data/cloudSync.js.
    function noteFields() {
      return ['CoreStackNotes', 'CoreStackAnnotations', 'AIStackNotes', 'AIStackAnnotations',
              'ProjectsNotes', 'ProjectsAnnotations',
              'DSAPrepNotes', 'InterviewKitNotes', 'InterviewPrepNotes'];
    }

    // Like git refusing a non-fast-forward push: a save that changes a note
    // must name the revision it was built on (_write.base), and is refused
    // unless that is still the note's newest revision (_rev). It may change
    // one note only, and moves that note's revision up by exactly one. A
    // save that changes no note mustn't touch _rev either.
    function fastForward() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(noteFields()) && !changed.hasAny(['_rev']))
        || (changed.hasAny(noteFields()) && oneNoteOnTop(changed));
    }

    function oneNoteOnTop(changed) {
      let before = resource.data;
      let after = request.resource.data;
      let w = after._write;
      let head = before.get('_rev', {}).get(w.key, {}).get(w.id, 0);
      return w.key in noteFields()
        && changed.intersection(noteFields().toSet()).hasOnly([w.key])
        && after.get(w.key, {}).diff(before.get(w.key, {})).affectedKeys().hasOnly([w.id])
        && w.base == head
        && after._rev.diff(before.get('_rev', {})).affectedKeys().hasOnly([w.key])
        && after._rev[w.key].diff(before.get('_rev', {}).get(w.key, {})).affectedKeys().hasOnly([w.id])
        && after._rev[w.key][w.id] == head + 1;
    }

    match /userProgress/{uid} {
      allow read, create: if signedInAs(uid);
      allow update: if signedInAs(uid) && fastForward();

      match /noteAssets/{assetId} {
        allow read, delete: if signedInAs(uid);
        // A Firestore document caps at 1 MB; the app compresses well below that,
        // and this keeps an oversized write from ever being attempted.
        allow create, update: if signedInAs(uid)
                              && request.resource.data.data is string
                              && request.resource.data.data.size() < 900000;
      }

      // One note per document, fast-forward only, like the note fields of the
      // main document above: a save names the revision it was built on (base)
      // and is refused unless that is still the head; the revision moves up
      // by exactly one. A note's first document builds on the main document's
      // copy of it, if there is one. Never deleted: a deleted note keeps its
      // document, marked deleted, so the main document's old copy can't
      // come back.
      function validNote(noteId) {
        let n = request.resource.data;
        return n.keys().hasOnly(['key', 'id', 'value', 'deleted', 'rev', 'base', 'updatedAt'])
          && n.key in noteFields()
          && n.id is string
          && n.deleted is bool
          && n.rev is int
          && n.base is int
          && n.rev == n.base + 1
          && noteId.matches(n.key + '~.+');
      }

      function mainHead(key, id) {
        let main = /databases/$(database)/documents/userProgress/$(uid);
        return exists(main) ? get(main).data.get('_rev', {}).get(key, {}).get(id, 0) : 0;
      }

      match /notes/{noteId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid) && validNote(noteId)
                      && request.resource.data.base == mainHead(request.resource.data.key, request.resource.data.id);
        allow update: if signedInAs(uid) && validNote(noteId)
                      && request.resource.data.key == resource.data.key
                      && request.resource.data.id == resource.data.id
                      && request.resource.data.base == resource.data.rev;
      }

      // Everything else, one document per key: { value, _meta, updatedAt }.
      // Edits are decided per entry by edit time in the app. Not deletable.
      match /data/{key} {
        allow read, create, update: if signedInAs(uid);
      }

      // Version history: every saved version of each note, like commits in
      // git. APPEND-ONLY — a revision can be created and read, never changed
      // or deleted, so no device (and no bug) can rewrite history.
      match /history/{target}/revisions/{revisionId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
                      && request.resource.data.text is string
                      && request.resource.data.text.size() < 1000000;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
