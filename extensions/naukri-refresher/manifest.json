{
  "manifest_version": 3,
  "name": "Naukri Refresher",
  "version": "1.5.0",
  "description": "Keeps your Naukri profile fresh (one trailing dot on the headline, about once an hour) and reads every Naukri listing of the last 48 hours to find the best matches for your Backend and AI profiles, each one rated against your resume by Grok.",
  "minimum_chrome_version": "121",
  "permissions": ["alarms", "storage", "unlimitedStorage", "scripting", "notifications", "power"],
  "host_permissions": ["https://www.naukri.com/*", "https://interviewplanprep.vercel.app/*", "https://api.x.ai/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*-jobs*", "https://www.naukri.com/job-listings-*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://interviewplanprep.vercel.app/*"],
      "js": ["site-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Naukri Refresher",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "naukri-refresher@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
